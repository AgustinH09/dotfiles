#!/bin/zsh

# Agent Mode Detection
if [[ -n "$npm_config_yes" ]] || [[ -n "$CI" ]] || [[ "$-" != *i* ]] || \
   [[ "$TERM_PROGRAM" == "vscode" ]] || [[ -n "$CURSOR_AGENT" ]] || [[ -n "$OPENCODE" ]]; then
  export AGENT_MODE=true
else
  export AGENT_MODE=false
fi

# --- Helper Functions ---
# Safe source - only source if file exists
safe_source() {
  [[ -f "$1" ]] && source "$1" || return 0
}

# Safe eval - only eval if command exists
safe_eval() {
  local cmd=$1
  shift
  if command -v "$cmd" &> /dev/null; then
    eval "$($cmd "$@")"
    return $?
  fi
  return 1
}

# Export only if directory exists
export_if_exists() {
  local var_name=$1
  local var_value=$2

  if [[ -d "$var_value" ]]; then
    export "$var_name=$var_value"
    return 0
  fi
  return 1
}

# --- Path Configuration ---
typeset -U path

path=(
  $HOME/.opencode/bin
  $HOME/.local/share/bob/nvim-bin
  $HOME/.ebcli-virtual-env/executables
  $HOME/.local/bin
  $HOME/bin
  $HOME/.bun/bin
  /usr/local/go/bin
  $HOME/go/bin
  /usr/local/bin
  $path
)

if [[ -d "$HOME/.antigravity/antigravity/bin" ]]; then
  path=("$HOME/.antigravity/antigravity/bin" $path)
fi

if [[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ]]; then
  path=("$HOME/.antigravity-ide/antigravity-ide/bin" $path)
fi

if [[ -d "$HOME/Android/Sdk" ]]; then
  path+=(
    "$HOME/Android/Sdk/tools"
    "$HOME/Android/Sdk/tools/bin"
    "$HOME/Android/Sdk/platform-tools"
  )
fi

export PATH

# Brew
{{ if eq .chezmoi.os "darwin" }}
if [ -x "/opt/homebrew/bin/brew" ]; then
  safe_eval /opt/homebrew/bin/brew shellenv
elif [ -x "/usr/local/bin/brew" ]; then
  safe_eval /usr/local/bin/brew shellenv
fi
{{ else }}
safe_eval /home/linuxbrew/.linuxbrew/bin/brew shellenv
{{ end }}

# --- Oh-My-Zsh Config ---
export ZSH="$HOME/.oh-my-zsh"

HISTSIZE=50000
SAVEHIST=50000
HIST_STAMPS="dd/mm/yyyy - %H:%M:%S"

setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt append_history inc_append_history share_history
setopt dot_glob
setopt extended_glob

# --- Completion Config ---
if [[ "$AGENT_MODE" != "true" ]]; then
  ZSTYLE_COMPLETION_CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/compcache"
  mkdir -p "$ZSTYLE_COMPLETION_CACHE_PATH"

  zstyle ':completion:*' use-cache on
  zstyle ':completion:*' cache-path "$ZSTYLE_COMPLETION_CACHE_PATH"
  zstyle ':completion:*' menu select
  zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
fi

# Direnv
safe_eval direnv hook zsh

# --- Theme & Plugins ---
if [[ "$AGENT_MODE" == "true" ]]; then
  ZSH_THEME=""
  plugins=(bundler git rails sudo)
else
  pokemon-colorscripts -r

  if command -v tmux &> /dev/null && [ -z "$TMUX" ]; then
    if [[ "$TERM_PROGRAM" == "Orca" ]]; then
      orca_session="orca-${ORCA_TERMINAL_HANDLE:-${ORCA_WORKTREE_ID:-$$}}"
      orca_session="${orca_session//[^A-Za-z0-9_-]/_}"
      tmux new-session -A -s "$orca_session"
      unset orca_session
    else
      tmux new-session -A -s main
    fi
  fi

  ZSH_THEME="powerlevel10k/powerlevel10k"
  safe_source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"

  zstyle ':omz:plugins:alias-finder' autoload yes
  zstyle ':omz:plugins:alias-finder' exact yes
  zstyle ':omz:plugins:alias-finder' cheaper yes

  plugins=(alias-finder aws bgnotify bundler colorize gem git golang mise npm rails rake-fast ruby sudo terraform tmux zsh-vi-mode zsh-autosuggestions)
fi

source $ZSH/oh-my-zsh.sh

# --- User Config ---
export MANPATH="/usr/bin/man:$MANPATH"
export LANG=en_US.UTF-8

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
  export VISUAL='vim'
else
  export EDITOR='nvim'
  export VISUAL='nvim'
fi

# --- Aliases ---
alias n='nvim'
alias v='nvim'
alias lg='lazygit'
alias ld='lazydocker'
alias cat='bat'
alias ls='eza --icons=always'
alias ll='eza -lh --icons=always'
alias la='eza -lah --icons=always'
alias tree='eza --tree --icons=always'

# --- Environment Variables ---

# Bitwarden SSH Agent
{{ if eq .chezmoi.os "darwin" -}}
export SSH_AUTH_SOCK=~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock
{{ else -}}
export SSH_AUTH_SOCK="/home/$USER/.bitwarden-ssh-agent.sock"
{{ end -}}

{{ if eq .chezmoi.os "linux" }}
# Hyprland
export XDG_SESSION_DESKTOP=hyprland
export XDG_CURRENT_DESKTOP=hyprland
export XDG_SESSION_TYPE=wayland

# fcitx5
export LC_CTYPE=en_US.UTF-8
export XMODIFIERS="@im=fcitx"
export QT_IM_MODULE=fcitx
export SDL_IM_MODULE=fcitx
export GLFW_IM_MODULE=ibus
{{ end }}

# Docker Host
export DOCKER_HOST="unix:///var/run/docker.sock"

# Golang
export_if_exists GOPATH "$HOME/go"

# Android SDK
{{ if eq .chezmoi.os "darwin" }}
export_if_exists ANDROID_HOME "$HOME/Library/Android/sdk"
{{ else }}
export_if_exists ANDROID_HOME "$HOME/Android/Sdk"
{{ end }}
if [[ -n "$ANDROID_HOME" ]]; then
  path+=(
    "$ANDROID_HOME/tools"
    "$ANDROID_HOME/tools/bin"
    "$ANDROID_HOME/platform-tools"
  )
fi

# Bat
export BAT_THEME="tokyonight_moon"

# GPG Key
export GPG_TTY=$(tty)

# API Keys
safe_source ~/.api_keys

# RTK
export RTK_TELEMETRY_DISABLED=1

# --- Tools ---

# Mise
{{ if eq .chezmoi.os "darwin" -}}
safe_eval mise activate zsh
{{ else -}}
safe_eval ~/.local/bin/mise activate zsh
{{ end -}}

# Zoxide
safe_eval zoxide init zsh --cmd cd

# Terraform
complete -C /usr/bin/terraform terraform

# TheFuck
safe_eval thefuck --alias fk

# fzf
safe_source <(fzf --zsh)

show_file_or_dir_preview="if [ -d {} ]; then eza --tree --color=always {} | head -200; else bat -n --color=always --line-range :500 {}; fi"

export FZF_CTRL_T_OPTS="--preview '$show_file_or_dir_preview' --tmux"
export FZF_ALT_C_OPTS="--preview 'eza --tree --color=always {} | head -200' --tmux"

_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)           fzf --preview  'eza --tree --color=always {} | head -200' "$@" ;;
    export|unset) fzf --preview "eval 'echo ${}'"       "$@" ;;
    ssh)          fzf --preview 'dig {}'                 "$@" ;;
    *)            fzf --preview "$show_file_or_dir_preview" "$@" ;;
  esac
}

# Atuin
safe_source "$HOME/.atuin/bin/env"
safe_eval atuin init zsh

# fzf-git.sh
safe_source $HOME/.oh-my-zsh/tools/fzf-git.sh

# Conda
__conda_setup="$('$HOME/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "$HOME/anaconda3/etc/profile.d/conda.sh" ]; then
        . "$HOME/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="$HOME/anaconda3/bin:$PATH"
    fi
fi
unset __conda_setup

# Syntax Highlighting
{{ if eq .chezmoi.os "darwin" }}
if command -v brew &> /dev/null; then
  safe_source "$(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
{{ else }}
safe_source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
{{ end }}

# --- Tmux ---
if [ -n "$TMUX" ]; then
  tmux-git-autofetch() {($HOME/.tmux/plugins/tmux-git-autofetch/git-autofetch.tmux --current &)}
  add-zsh-hook chpwd tmux-git-autofetch

  case "$TERM" in
    linux|xterm*|rxvt*)
      export PROMPT_COMMAND='echo -ne "\033]0;${HOSTNAME%%.*}: ${PWD##*/}\007"'
      ;;
    screen*)
      export PROMPT_COMMAND='echo -ne "\033k${HOSTNAME%%.*}: ${PWD##*/}\033\\" '
      ;;
    *)
      ;;
  esac
fi

# --- Yazi ---
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# --- Fabric ---
fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit && compinit

# --- Optional Tools ---
# Undistract-me
#export LONG_RUNNING_COMMAND_TIMEOUT=20
#export UDM_PLAY_SOUND=1
#source /etc/profile.d/undistract-me.sh

# grit
safe_source "$HOME/.grit/bin/env"

# Cargo
safe_source "$HOME/.cargo/env"

# --- Agent Mode Overrides ---
if [[ "$AGENT_MODE" == "true" ]]; then
  PROMPT='%n@%m:%~%# '
  RPROMPT=''

  unsetopt CORRECT
  unsetopt CORRECT_ALL
  setopt NO_BEEP
  setopt NO_HIST_BEEP
  setopt NO_LIST_BEEP
  setopt NO_FLOW_CONTROL
  setopt HASH_CMDS
  setopt HASH_DIRS
  setopt SHORT_LOOPS

  unsetopt SHARE_HISTORY
  unsetopt INC_APPEND_HISTORY
  unsetopt AUTO_LIST

  export PAGER=cat

  alias yarn='yarn --non-interactive'
  alias pip='pip --quiet'
  alias git='git -c advice.detachedHead=false'

  if command -v direnv &> /dev/null; then
    eval "$(direnv export zsh)"
  fi
else
  safe_source ~/.p10k.zsh
fi


# --- Profiling ---
if [[ "$PROFILE_STARTUP" == "true" ]]; then
  print_startup_profile
fi
