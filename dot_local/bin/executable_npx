#!/usr/bin/env bash
# --- Zero-Trust Containerized npx ---

USERNS_ARGS=""
if [[ "$(uname -s)" == "Linux" ]]; then
  USERNS_ARGS="--userns=keep-id"
fi

if [[ "$AGENT_MODE" == "true" ]]; then
  exec podman run --rm $USERNS_ARGS -v "$(pwd):/workspace" -w /workspace -p 3000:3000 -p 5173:5173 -p 8080:8080 docker.io/library/node:lts npx "$@"
else
  if [ -t 0 ]; then
    TTY_ARGS="-it"
  else
    TTY_ARGS=""
  fi
  exec podman run --rm $TTY_ARGS $USERNS_ARGS -v "$(pwd):/workspace" -w /workspace -p 3000:3000 -p 5173:5173 -p 8080:8080 docker.io/library/node:lts-alpine npx "$@"
fi
