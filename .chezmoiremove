# Files removed from source upstream that should also be cleaned from
# the destination on every `chezmoi apply`. chezmoi does not auto-remove
# orphans by default, so this list is the declarative way to do it.
#
# NOTE: paths under
#   .gemini/extensions/gemini-cli-security/mcp-server/node_modules/
# were intentionally NOT added here — those are managed by `npm install`
# and removing them on every apply would fight the package manager.

# nvim agent docs (consolidated/removed upstream)
.config/nvim/AGENTS.md
.config/nvim/AGENT_DEBUGGING.md
.config/nvim/AGENT_IMPLEMENTATION.md
.config/nvim/AGENT_KEYBINDING.md
.config/nvim/AGENT_LANGUAGE.md
.config/nvim/AGENT_MAINTENANCE.md
.config/nvim/AGENT_PERFORMANCE.md
.config/nvim/GEMINI.md

# nvim plugin specs deprecated/replaced upstream
.config/nvim/lua/plugins/avante.lua
.config/nvim/lua/plugins/gp.lua
.config/nvim/lua/plugins/mcphub.lua

# nvim opencode JSON config (replaced by opencode.nvim plugin)
.config/nvim/opencode.json

# mozc IME databases (no longer tracked upstream)
.config/mozc/cform.db
.config/mozc/.history.db
.config/mozc/.session.ipc
.config/mozc/segment.db

