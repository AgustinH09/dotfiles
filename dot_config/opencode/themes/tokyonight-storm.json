{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "tn_bg": "#24283b",
    "tn_bg_dark": "#1f2335",
    "tn_bg_highlight": "#292e42",
    "tn_bg_visual": "#2e3c64",
    "tn_fg": "#c0caf5",
    "tn_fg_dark": "#a9b1d6",
    "tn_fg_gutter": "#3b4261",
    "tn_comment": "#565f89",
    "tn_dark5": "#737aa2",
    "tn_blue": "#7aa2f7",
    "tn_blue1": "#2ac3de",
    "tn_blue5": "#89ddff",
    "tn_blue7": "#394b70",
    "tn_cyan": "#7dcfff",
    "tn_magenta": "#bb9af7",
    "tn_green": "#9ece6a",
    "tn_green1": "#73daca",
    "tn_red": "#f7768e",
    "tn_red1": "#db4b4b",
    "tn_orange": "#ff9e64",
    "tn_yellow": "#e0af68",
    "tn_diff_add_bg": "#283b4d",
    "tn_diff_del_bg": "#3f2d3d"
  },
  "theme": {
    "primary": { "dark": "tn_blue", "light": "tn_blue" },
    "secondary": { "dark": "tn_magenta", "light": "tn_magenta" },
    "accent": { "dark": "tn_cyan", "light": "tn_cyan" },
    "error": { "dark": "tn_red", "light": "tn_red" },
    "warning": { "dark": "tn_orange", "light": "tn_orange" },
    "success": { "dark": "tn_green", "light": "tn_green" },
    "info": { "dark": "tn_blue1", "light": "tn_blue1" },
    "text": { "dark": "tn_fg", "light": "tn_fg" },
    "textMuted": { "dark": "tn_dark5", "light": "tn_dark5" },
    "background": { "dark": "tn_bg", "light": "tn_bg" },
    "backgroundPanel": { "dark": "tn_bg_dark", "light": "tn_bg_dark" },
    "backgroundElement": { "dark": "tn_bg_highlight", "light": "tn_bg_highlight" },
    "border": { "dark": "tn_fg_gutter", "light": "tn_fg_gutter" },
    "borderActive": { "dark": "tn_blue", "light": "tn_blue" },
    "borderSubtle": { "dark": "tn_bg_highlight", "light": "tn_bg_highlight" },
    "diffAdded": { "dark": "tn_green", "light": "tn_green" },
    "diffRemoved": { "dark": "tn_red", "light": "tn_red" },
    "diffContext": { "dark": "tn_comment", "light": "tn_comment" },
    "diffHunkHeader": { "dark": "tn_blue7", "light": "tn_blue7" },
    "diffHighlightAdded": { "dark": "tn_green1", "light": "tn_green1" },
    "diffHighlightRemoved": { "dark": "tn_red1", "light": "tn_red1" },
    "diffAddedBg": { "dark": "tn_diff_add_bg", "light": "tn_diff_add_bg" },
    "diffRemovedBg": { "dark": "tn_diff_del_bg", "light": "tn_diff_del_bg" },
    "diffContextBg": { "dark": "tn_bg", "light": "tn_bg" },
    "diffLineNumber": { "dark": "tn_fg_gutter", "light": "tn_fg_gutter" },
    "diffAddedLineNumberBg": { "dark": "tn_diff_add_bg", "light": "tn_diff_add_bg" },
    "diffRemovedLineNumberBg": { "dark": "tn_diff_del_bg", "light": "tn_diff_del_bg" },
    "markdownText": { "dark": "tn_fg", "light": "tn_fg" },
    "markdownHeading": { "dark": "tn_blue", "light": "tn_blue" },
    "markdownLink": { "dark": "tn_cyan", "light": "tn_cyan" },
    "markdownLinkText": { "dark": "tn_blue1", "light": "tn_blue1" },
    "markdownCode": { "dark": "tn_green", "light": "tn_green" },
    "markdownBlockQuote": { "dark": "tn_comment", "light": "tn_comment" },
    "markdownEmph": { "dark": "tn_orange", "light": "tn_orange" },
    "markdownStrong": { "dark": "tn_yellow", "light": "tn_yellow" },
    "markdownHorizontalRule": { "dark": "tn_fg_gutter", "light": "tn_fg_gutter" },
    "markdownListItem": { "dark": "tn_blue", "light": "tn_blue" },
    "markdownListEnumeration": { "dark": "tn_blue", "light": "tn_blue" },
    "markdownImage": { "dark": "tn_magenta", "light": "tn_magenta" },
    "markdownImageText": { "dark": "tn_blue1", "light": "tn_blue1" },
    "markdownCodeBlock": { "dark": "tn_fg", "light": "tn_fg" },
    "syntaxComment": { "dark": "tn_comment", "light": "tn_comment" },
    "syntaxKeyword": { "dark": "tn_magenta", "light": "tn_magenta" },
    "syntaxFunction": { "dark": "tn_blue", "light": "tn_blue" },
    "syntaxVariable": { "dark": "tn_fg", "light": "tn_fg" },
    "syntaxString": { "dark": "tn_green", "light": "tn_green" },
    "syntaxNumber": { "dark": "tn_orange", "light": "tn_orange" },
    "syntaxType": { "dark": "tn_blue1", "light": "tn_blue1" },
    "syntaxOperator": { "dark": "tn_blue5", "light": "tn_blue5" },
    "syntaxPunctuation": { "dark": "tn_blue5", "light": "tn_blue5" }
  }
}
