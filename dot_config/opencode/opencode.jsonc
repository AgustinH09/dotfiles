  // Bridge safeguard (council): the cursor-acp tool-call shim is
  // translation-lossy, and mcptool MCP-bridge calls ride the bash channel —
  // so nothing mutates or leaves the machine without a prompt. Relax
  // per-project with an opencode.json of allow-rules if this gets noisy.
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "websearch": "ask"
  },

  // Ported from ~/.cursor/mcp.json
  "mcp": {
    "linkedin": {
      "type": "local",
      "command": ["uvx", "mcp-server-linkedin@latest"],
      "enabled": true,
      "environment": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    }
  }
}
