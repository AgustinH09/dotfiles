{
  "$schema": "https://opencode.ai/config.json",

  // Extra instruction files combined with AGENTS.md / CLAUDE.md.
  // NOTE: ~/.claude/CLAUDE.md (+ its @RTK.md reference) keeps loading via
  // Claude Code compatibility, so RTK token-saver instructions stay active.
  "instructions": ["~/.config/opencode/personal-rules.md"],

  // Fast/cheap model for title + summary housekeeping agents.
  "small_model": "google/gemini-3.5-flash",

  // Never auto-share sessions; explicit /share only.
  "share": "manual",
  "autoupdate": "notify",

  // npm plugins (auto-installed via Bun at startup, cached in ~/.cache/opencode).
  // Versions pinned deliberately; opencode-update-notifier flags newer releases.
  // - telemetry:   local SQLite session/cost logging w/ orchestration-chain rollups
  // - dcp:         prunes obsolete tool outputs from context (rtk covers input side)
  // - ntfy.sh:     push notifications to phone (topic in notification-ntfy.json)
  // - snippets:    #hashtag inline text expansion in the prompt editor
  // - handoff:     focused handoff prompts for continuing work in a new session
  "plugin": [
    "opencode-telemetry@0.1.19",
    "@tarquinen/opencode-dcp@3.1.14",
    "opencode-ntfy.sh@1.1.0",
    "opencode-update-notifier@0.3.3",
    "opencode-snippets@3.0.0",
    "opencode-handoff@0.5.0"
  ],

  // Ported from ~/.cursor/mcp.json
  "mcp": {
    "linkedin": {
      "type": "local",
      "command": ["uvx", "mcp-server-linkedin@latest"],
      "enabled": true,
      "environment": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true
    }
  }
}
