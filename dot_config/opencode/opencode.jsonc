              "cost": {
                "input": 1.75,
                "output": 14,
                "cache_read": 0.175,
                "cache_write": 1.75
              }
            },
            "high": {
              "cursorModel": "gpt-5.3-codex-high",
              "cost": {
                "input": 1.75,
                "output": 14,
                "cache_read": 0.175,
                "cache_write": 1.75
              }
            },
            "high-fast": {
              "cursorModel": "gpt-5.3-codex-high-fast",
              "cost": {
                "input": 1.75,
                "output": 14,
                "cache_read": 0.175,
                "cache_write": 1.75
              }
            },
            "xhigh": {
              "cursorModel": "gpt-5.3-codex-xhigh",
              "cost": {
                "input": 1.75,
                "output": 14,
                "cache_read": 0.175,
                "cache_write": 1.75
              }
            },
            "xhigh-fast": {
              "cursorModel": "gpt-5.3-codex-xhigh-fast",
              "cost": {
                "input": 1.75,
                "output": 14,
                "cache_read": 0.175,
