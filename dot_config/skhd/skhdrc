# Clipboard manager — set this hotkey INSIDE Raycast instead:
#   Raycast > Settings > Extensions > Clipboard History > Hotkey: cmd+alt+v
# Raycast handles toggle/escape natively; skhd deep-links don't toggle.

# Lock screen
cmd + ctrl - l : pmset displaysleepnow

# Toggle Dock visibility (like Hyprland CTRL+ALT+B toggle waybar)
alt - g : osascript -e 'tell application "System Events" to set autohide of dock preferences to not (autohide of dock preferences)'

# Restart yabai + skhd
ctrl + alt - r : yabai --restart-service && skhd --restart-service
